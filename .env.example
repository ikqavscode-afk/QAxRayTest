# Необязательные настройки QAxRayTest. Файл .env приложением не читается:
# задайте переменные в оболочке, например: export QAXRAY_HTTP_TIMEOUT=15
# Пустое значение = значение по умолчанию. Значения вне границ отклоняются при запуске.

# Тайм-аут одного запроса, секунды (1 - 30, по умолчанию 10)
QAXRAY_HTTP_TIMEOUT=10

# Максимум читаемых байт ответа (10000 - 5000000, по умолчанию 1000000)
QAXRAY_MAX_BYTES=1000000

# Максимум перенаправлений, каждое проверяется политикой адресов (0 - 10, по умолчанию 5)
QAXRAY_MAX_REDIRECTS=5

# Повторы только при сетевых сбоях (0 - 3, по умолчанию 2)
QAXRAY_MAX_RETRIES=2

# Пауза между повторами, секунды (0 - 5, по умолчанию 0.5)
QAXRAY_RETRY_DELAY=0.5

# Защита от запросов во внутренние сети не настраивается и отключить её нельзя.
